{define #custom_head}
<link rel="icon" href="https://mitglieder.{getenv("DOMAINNAME")}/favicon.png">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://mitglieder.{getenv("DOMAINNAME")}/css/tabler-icons.min.css"/>
<style>
nav a {
    font-size: 1rem;
    margin-left: 0px;
}
#archive-table :is(button, .button, input[type="submit"], input[type="button"]):hover {
    background: inherit;
}
/* Listig's built-in cards inside our panel: no second panel look. */
.panel .card {
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0 0 1.5rem;
}
.panel .card:last-child { margin-bottom: 0; }
/* The dashboard brings one section per kind of list (subscribed / can join / others): each its own panel. */
.dashboard-section {
    padding: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow);
}
.dashboard-section + .dashboard-section { margin-top: 1.5rem; }
.dashboard-section h2 { margin: 0 0 1rem; font-size: 1.1rem; }
.dashboard-section p { margin-top: 0; color: var(--muted); }
.page-header .page-actions { margin-top: .25rem; }
.page-header .list-actions { margin: 0; }
</style>
{/define}

{define nav-link, $label, $href, $icon, $attributes}
    <a href="{$href}" n:attr="$attributes"><i class="ti ti-{$icon} nav-icon" aria-hidden="true"></i> {$label}</a>
{/define}

{define #custom_header}
<a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
<input id="nav-toggle" type="checkbox" aria-hidden="true">

<div class="topbar">
  <label class="brand" for="nav-toggle">
    <img src="https://mitglieder.{getenv("DOMAINNAME")}/img/mhn-logo-small.png" alt="MHN-Logo">
    <div class="brand-text">
      <span class="name">Mind-Hochschul-Netzwerk</span>
      <span class="caption">Mailinglisten</span>
    </div>
  </label>

  <label class="nav-toggle" for="nav-toggle" aria-controls="site-navigation" aria-label="Navigation öffnen">
    <span class="hamburger" aria-hidden="true"></span>
  </label>
</div>

<div class="sidebar" id="site-navigation" aria-label="Seitennavigation">
    <nav>
        <p class="sidebar-section-label">Mitgliederverzeichnis</p>
        {var $mitgliederUrl = 'https://mitglieder.' . getenv('DOMAINNAME')}
        {include nav-link, 'Mitgliedersuche', $mitgliederUrl, 'user-search', suche}
        {include nav-link, 'Meine Daten', $mitgliederUrl . '/user/self/edit', 'user', bearbeiten}
        {include nav-link, 'Einwilligungen', $mitgliederUrl . '/user/self/agreements', 'shield-check', einwilligungen}
        {include nav-link, 'Gruppen', $mitgliederUrl . '/groups', 'users-group', ['class' => 'active']}

        <p class="sidebar-section-label">MHN-Tools</p>
        {include nav-link, 'Wiki', 'https://wiki.' . getenv('DOMAINNAME'), 'book'}
        {include nav-link, 'Veranstaltungen', 'https://www.' . getenv('DOMAINNAME') . '/veranstaltungen', 'calendar-event'}
        {include nav-link, 'Mind-Akademie', 'https://mind-akademie.de/', 'school'}

        <p class="sidebar-section-label">MHN</p>
        {include nav-link, 'MHN-Webseite', 'https://www.' . getenv('DOMAINNAME'), 'home'}
        {include nav-link, 'Datenschutz', 'https://www.mind-hochschul-netzwerk.de/mod/book/view.php?id=253&amp;chapterid=4', 'file-text-shield'}
        {include nav-link, 'Impressum', 'https://www.mind-hochschul-netzwerk.de/mod/book/view.php?id=253&amp;chapterid=5', 'file'}

        <div class="sidebar-bottom">
            <p class="sidebar-section-label">Konto</p>
            {include nav-link, 'Logout', '#', 'logout', [onclick => "listigLogout(event)"]}
        </div>
    </nav>
</div>

<label class="overlay" for="nav-toggle" tabindex="-1"></label>
{/define}

{* Heading area: title, description and the list's action buttons (Listig passes them as
   $title, $description, $actions; $list is set on every list page). *}
{define #custom_page_header}
<section class="page-header" aria-labelledby="title">
    <div class="summary">
        <span class="page-label"><i class="ti ti-mail" aria-hidden="true"></i> <a href="/">Mailinglisten</a></span>
        {if empty($list)}
            <h1 id="title">{if trim((string) $title) !== ''}{$title}{else}Mailinglisten{/if}</h1>
            {if getTemplateName() === 'dashboard.latte'}
                <div class="summary">
                    Hier findest du die Mailinglisten, die du abonniert hast, und &ndash; falls vorhanden &ndash;
                    weitere Listen, denen du beitreten kannst. Die Verwaltung der Mailinglisten findest du unter
                    dem Men&uuml;punkt <a href="https://mitglieder.{getenv('DOMAINNAME')}/groups">Gruppen</a>.
                </div>
            {/if}
        {else}
            <h1 id="title">{$list->displayName}</h1>
            <div class="summary">
                {$list->description}
            </div>
        {/if}
    </div>
    <div class="page-actions" n:if="trim((string) $actions) !== ''">{$actions}</div>
</section>
{/define}

{* The whole page frame in one block: no tags opened here and closed elsewhere. *}
{define #custom_main}
<main class="main-content" id="main-content">
    {$pageHeader}

    {if getTemplateName() === 'dashboard.latte'}
        {* the dashboard already consists of panels (.dashboard-section) *}
        {$content}
    {else}
    <section class="panel" aria-labelledby="panel-heading">
        <h2 id="panel-heading">{switch getTemplateName()}
            {case "list/index.latte"}<i class="ti ti-info-circle" aria-hidden="true"></i> Info
            {case "list/manage.latte"}<i class="ti ti-settings" aria-hidden="true"></i> Verwaltung
            {case "archive/index.latte"}<i class="ti ti-archive" aria-hidden="true"></i> Archiv
            {case "archive/show.latte"}<i class="ti ti-archive" aria-hidden="true"></i> Archiv
            {case "compose.latte"}<i class="ti ti-send" aria-hidden="true"></i> Mail an externe Adresse
            {default}<i class="ti ti-layout-dashboard" aria-hidden="true"></i> Übersicht
            {/switch}
        </h2>
        {$content}
    </section>
    {/if}

    <p class="attribution"><a href="https://github.com/hengeb/listig">powered by Listig</a></p>
</main>
{/define}

{* Our own attribution sits inside custom_main (below the panel) — suppress the built-in one. *}
{define #custom_attribution}{/define}
